<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartEvent.Mobile.Presentation.Components.EventCard">

    <Border Style="{StaticResource EventCardBorderStyle}">

        <VerticalStackLayout>

            <Image Source="{Binding ImageUrl}"
                   Aspect="AspectFill"
                   HeightRequest="160" />

            <VerticalStackLayout Padding="16" Spacing="4">

                <Label Text="{Binding Name}"
                       Style="{StaticResource EventTitleLabelStyle}" />

                <Label Text="{Binding Description}"
                       Style="{StaticResource EventDescriptionLabelStyle}" />

                <HorizontalStackLayout Spacing="5" Margin="0,8,0,0">

                    <Label Text="🕒"
                           Style="{StaticResource EventTimeIconStyle}" />

                    <Label Text="{Binding StartTime, StringFormat='{0:f}'}"
                           Style="{StaticResource EventTimeLabelStyle}" />

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </Border>

</ContentView>
