<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SmartEvent.Mobile.Presentation.ViewModels"
    xmlns:dto="clr-namespace:SmartEvent.Mobile.Core.DTOs.ParticipantDTOs.Responses;assembly=SmartEvent.Mobile.Core"
    xmlns:res="clr-namespace:SmartEvent.Mobile.Resources.Localization"
    x:Class="SmartEvent.Mobile.Presentation.Views.ParticipantsPage"
    x:DataType="vm:ParticipantsViewModel"
    BackgroundColor="{DynamicResource BackgroundColor}"
    Title="{x:Static res:AppResources.ParticipantsTitle}">

    <Grid RowDefinitions="Auto, *" Padding="20,10">

        <!-- Вкладки (Tabs) -->
        <VerticalStackLayout Grid.Row="0" Spacing="1">
            <Grid ColumnDefinitions="*,*" Margin="0">

                <!-- Таб: Registered -->
                <Grid Grid.Column="0" Style="{StaticResource TabContainerStyle}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowRegisteredCommand}" />
                    </Grid.GestureRecognizers>

                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding Current}" Value="Registered">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TabSelectedBackground}" />
                        </DataTrigger>
                    </Grid.Triggers>

                    <Label Text="{x:Static res:AppResources.Registered}" 
                           Style="{StaticResource TabLabelStyle}" />
                </Grid>

                <!-- Таб: Visited -->
                <Grid Grid.Column="1" Style="{StaticResource TabContainerStyle}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowVisitedCommand}" />
                    </Grid.GestureRecognizers>

                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding Current}" Value="Visited">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TabSelectedBackground}" />
                        </DataTrigger>
                    </Grid.Triggers>

                    <Label Text="{x:Static res:AppResources.Attended}" 
                           Style="{StaticResource TabLabelStyle}" />
                </Grid>
            </Grid>
        </VerticalStackLayout>

        <!-- Список участников -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CurrentParticipants}"
                        SelectionMode="None"
                        Margin="0,10,0,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:EventParticipantDto">
                    <Border Style="{StaticResource ParticipantCardStyle}">
                        <Label Text="{Binding FullName}" 
                               Style="{StaticResource ParticipantNameStyle}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="{x:Static res:AppResources.EmptyParticipantsList}" 
                       Style="{StaticResource EmptyListLabelStyle}" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Индикатор загрузки -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{DynamicResource PrimaryColor}"
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" />
    </Grid>
</ContentPage>