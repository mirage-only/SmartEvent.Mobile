<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="using:SmartEvent.Mobile.Presentation.ViewModels"
    xmlns:res="clr-namespace:SmartEvent.Mobile.Resources.Localization"
    x:DataType="viewModels:RegisterViewModel"
    x:Class="SmartEvent.Mobile.Presentation.Views.RegisterPage"
    Title="Registration"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{x:Static res:AppResources.RegistrationPage}"
                   FontSize="28"
                   HorizontalOptions="Center" />

            <Entry Placeholder="{x:Static res:AppResources.Email}"
                   Text="{Binding Email}"
                   Keyboard="Email" />

            <Entry Placeholder="{x:Static res:AppResources.Password}"
                   Text="{Binding Password}"
                   IsPassword="True" />

            <Entry Placeholder="{x:Static res:AppResources.PasswordConfirm}"
                   Text="{Binding ConfirmPassword}"
                   IsPassword="True" />

            <Entry Placeholder="{x:Static res:AppResources.FirstName}"
                   Text="{Binding Firstname}" />

            <Entry Placeholder="{x:Static res:AppResources.LastName}"
                   Text="{Binding Lastname}" />

            <Entry Placeholder="{x:Static res:AppResources.Patronymic}"
                   Text="{Binding Patronymic}" />

            <Button Text="{x:Static res:AppResources.RegisterButton}"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50" />

            <Button Text="{x:Static res:AppResources.LoginPageButton}"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50" />            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
