<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="using:SmartEvent.Mobile.Presentation.ViewModels"
    xmlns:res="clr-namespace:SmartEvent.Mobile.Resources.Localization"
    x:DataType="viewModels:RegisterViewModel"
    x:Class="SmartEvent.Mobile.Presentation.Views.RegisterPage"
    BackgroundColor="{DynamicResource BackgroundColor}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="{x:Static res:AppResources.RegistrationPage}"
                   FontSize="28"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource PrimaryColor}" />

            <!-- Email -->
            <Border Style="{StaticResource ThemedEntryContainer}">
                <Entry Style="{StaticResource ThemedEntry}"
                       Placeholder="{x:Static res:AppResources.Email}"
                       Text="{Binding Email}"
                       Keyboard="Email" />
            </Border>

            <!-- Password -->
            <Border Style="{StaticResource ThemedEntryContainer}">
                <Entry Style="{StaticResource ThemedEntry}"
                       Placeholder="{x:Static res:AppResources.Password}"
                       Text="{Binding Password}"
                       IsPassword="True" />
            </Border>

            <!-- Confirm Password -->
            <Border Style="{StaticResource ThemedEntryContainer}">
                <Entry Style="{StaticResource ThemedEntry}"
                       Placeholder="{x:Static res:AppResources.PasswordConfirm}"
                       Text="{Binding ConfirmPassword}"
                       IsPassword="True" />
            </Border>

            <!-- First Name -->
            <Border Style="{StaticResource ThemedEntryContainer}">
                <Entry Style="{StaticResource ThemedEntry}"
                       Placeholder="{x:Static res:AppResources.FirstName}"
                       Text="{Binding Firstname}" />
            </Border>

            <!-- Last Name -->
            <Border Style="{StaticResource ThemedEntryContainer}">
                <Entry Style="{StaticResource ThemedEntry}"
                       Placeholder="{x:Static res:AppResources.LastName}"
                       Text="{Binding Lastname}" />
            </Border>

            <!-- Patronymic -->
            <Border Style="{StaticResource ThemedEntryContainer}">
                <Entry Style="{StaticResource ThemedEntry}"
                       Placeholder="{x:Static res:AppResources.Patronymic}"
                       Text="{Binding Patronymic}" />
            </Border>

            <!-- Register button -->
            <Button Text="{x:Static res:AppResources.RegisterButton}"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="{DynamicResource SuccessButtonBackground}"
                    TextColor="{DynamicResource SuccessButtonTextColor}"
                    CornerRadius="8"
                    HeightRequest="50" />

            <!-- Login button -->
            <Button Text="{x:Static res:AppResources.LoginPageButton}"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="{DynamicResource PrimaryButtonBackground}"
                    TextColor="{DynamicResource PrimaryButtonTextColor}"
                    CornerRadius="8"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
